# Единая база и любые рабочие данные — не в git.
data/
*.db
*.db-wal
*.db-shm
*.session
.env
tmp/
# Python
__pycache__/
*.pyc
.pytest_cache/

# Отчёты прогонов (генерируются расписанием в reports/, не документация).
#   reports/report-ГГГГ-ММ-ДД.txt — `tuber report --save` (analysis/report.py);
#   reports/ГГГГ-ММ-ДД.md         — `tuber x report` (platforms/x/report.py::write).
# Дневные артефакты не должны пачкать рабочее дерево после каждого прогона.
reports/report-*.txt
reports/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md
reports/significance-*.md
